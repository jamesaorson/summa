# clangd configuration for summa. Base flags for every file come from
# compile_flags.txt at the repo root.

# The single-file headers are never compiled directly, so their definition
# sections are normally preprocessed out. Define every implementation guard so the definition sections are live code
# rather than greyed-out preprocessor blocks.
If:
  PathMatch: .*include/summa/.*\.h
CompileFlags:
  Add:
    # Headers that compose others (scheme.h, say) define these guards themselves
    # before including their dependencies, so the -D below redefines them.
    - -Wno-macro-redefined
    - -DSUMMA_ARRAY_IMPLEMENTATION
    - -DSUMMA_HASH_MAP_IMPLEMENTATION
    - -DSUMMA_HASH_SET_IMPLEMENTATION
    - -DSUMMA_REF_COUNT_IMPLEMENTATION
    - -DSUMMA_SCHEME_IMPLEMENTATION
    - -DSUMMA_STRING_IMPLEMENTATION
    - -DSUMMA_TEST_IMPLEMENTATION
